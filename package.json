{
  "name": "core-template-cf-reui",
  "version": "26.06.24",
  "description": "The template helps you build apps with Astro, Tailwind CSS, and shadcn/ui.",
  "license": "MIT",
  "author": {
    "name": "126colby",
    "url": "https://github.com/126colby"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jmbish04/core-template-cf-reui.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "start": "astro dev",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "oxlint && oxfmt && pnpm run typecheck",
    "db:generate": "drizzle-kit generate",
    "migrate:local": "pnpm run db:generate && npx wrangler d1 migrations apply DB --local",
    "migrate:remote": "pnpm run db:generate && npx wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm run guardian:project && pnpm run build && cp .assetsignore dist/.assetsignore && pnpm run migrate:remote && npx wrangler deploy",
    "deploy:preview": "pnpm run guardian:project && pnpm run build && cp .assetsignore dist/.assetsignore && npx wrangler versions upload",
    "cf-typegen": "wrangler types",
    "deps:lockfile": "corepack pnpm install --no-frozen-lockfile && wrangler types",
    "deps:update": "corepack pnpm update --latest && corepack pnpm install --no-frozen-lockfile && wrangler types",
    "selfcheck": "for f in scripts/selfcheck*.mjs; do node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON \"$f\" || exit 1; done",
    "typecheck": "tsc --noEmit",
    "guardian:project": "node scripts/set-guardian-project.mjs",
    "guardian:project:check": "node scripts/set-guardian-project.mjs --check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@base-ui/react": "^1.8.0",
    "@cloudflare/workers-types": "^5.20260930.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/code-block": "53.0.0",
    "@platejs/indent": "53.0.0",
    "@platejs/link": "53.3.5",
    "@platejs/list": "53.3.13",
    "@scalar/hono-api-reference": "^0.12.7",
    "@shadcn/react": "^0.3.1",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "0.8.3",
    "hono": "^4.13.11",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "platejs": "53.3.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.50.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "shadcn": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
