{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/frontend/styles/global.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@reui": {
      "url": "https://reui.io/r/styles/{style}/{name}.json?v=dpl_4VjmFsMM2fx9pEbCcjy1PJdoRHfL",
      "headers": {
        "Authorization": "Bearer ${REUI_LICENSE_KEY}"
      }
    },
    "@mcpcn": {
      "url": "https://mcpcn.vercel.app/r/{name}.json"
    }
  }
