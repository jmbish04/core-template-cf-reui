{
  "name": "core-template-cf-reui",
  "main": "./src/_worker.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  // All inference goes through core-guardian — see ~/AGENTS-ai.md. There is
  // no local Workers AI binding, no browser binding, and no worker_loaders
  // binding left in this Worker (they existed only for the removed agents).
  "services": [
    {
      "binding": "CORE_GUARDIAN",
      "service": "core-guardian",
      "entrypoint": "GuardianRpc",
      // Service bindings default to local mode in `wrangler dev`, which needs
      // a second `wrangler dev` process running core-guardian locally.
      // `remote: true` proxies to the real deployed core-guardian instead, so
      // local dev exercises the real AI router.
      "remote": true,
    },
  ],
  "migrations": [
    // v1 captures the original deployed-class set so wrangler can apply
    // an additive history. Do NOT rewrite this tag — it is immutable
    // once a Worker has shipped under it.
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OrchestratorAgent",
        "CodeModeAgent",
        "GoogleDocsAgent",
        "BrowserHitlAgent",
        "WorkflowsAgent",
        "ArtifactAgent",
      ],
    },
    // v2 brings the live Worker in line with the lean template:
    //   - retire OrchestratorAgent + GoogleDocsAgent (no longer exported)
    //   - introduce ChatBroker (assistant-ui WebSocket broker)
    //   - introduce NotificationsAgent (per-session realtime fanout)
    {
      "tag": "v2",
      "deleted_classes": ["OrchestratorAgent", "GoogleDocsAgent"],
      "new_sqlite_classes": ["ChatBroker", "NotificationsAgent"],
    },
    // v3 re-introduces the OrchestratorAgent (re-created additively after v2
    // retired it) as a live multi-agent coordinator, adds its specialist
    // sub-agents (ResearcherAgent, CoderAgent), and registers the three new
    // showcase agents (McpAgent, ThinkingAgent, SkillsAgent). v1/v2 are left
    // untouched — they are immutable history.
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "OrchestratorAgent",
        "ResearcherAgent",
        "CoderAgent",
        "McpAgent",
        "ThinkingAgent",
        "SkillsAgent",
      ],
    },
    // v4 is PRODUCTION HISTORY, not a new step: it was deployed 2026-07-07 from an
    // unmerged branch (GitHub agent). The live Worker's migration_tag is "v4", and
    // wrangler only sends tags newer than the live one — so v4 must stay exactly
    // what was deployed or later steps are silently skipped.
    {
      "tag": "v4",
      "new_sqlite_classes": ["GitHubAgent"],
    },
    // v5 retires every Durable Object / Agents SDK class (all 13 live after v4).
    // Chat runs through the CORE_GUARDIAN service binding + D1; notifications are
    // plain D1 CRUD. deleted_classes PERMANENTLY deletes each class's stored data
    // on deploy (no trash). Only `wrangler deploy` applies it — `versions upload`
    // (branch preview builds) rejects DO lifecycle changes with code 10064.
    // https://developers.cloudflare.com/durable-objects/reference/durable-object-class-migrations-legacy/#delete-migration
    {
      "tag": "v5",
      "deleted_classes": [
        "CodeModeAgent",
        "BrowserHitlAgent",
        "WorkflowsAgent",
        "ArtifactAgent",
        "ChatBroker",
        "NotificationsAgent",
        "OrchestratorAgent",
        "ResearcherAgent",
        "CoderAgent",
        "McpAgent",
        "ThinkingAgent",
        "SkillsAgent",
        "GitHubAgent",
      ],
    },
  ],
  // ---------------------------------------------------------------------------
  // Cloudflare Email Routing (inbound) — the `/inbox` showcase
  // ---------------------------------------------------------------------------
  //
  // RECEIVING email needs NO wrangler binding. The Worker exports an
  // `email(message, env, ctx)` handler (see src/_worker.ts +
  // src/backend/email/inbound.ts); Cloudflare invokes it when a Routing Rule
  // points an incoming address at this Worker. Set that up out-of-band:
  //
  //   Dashboard → the zone → Email → Email Routing →
  //     1. Enable Email Routing for the domain (adds the required MX + TXT/SPF).
  //     2. Routing Rules → "Send to a Worker" → select this Worker
  //        (core-template-cf-reui), or use a catch-all rule.
  //   …or via CLI:
  //     npx wrangler email routing rules create \
  //       --match "to=demo@yourdomain.com" --action worker \
  //       --value core-template-cf-reui
  //
  // FORWARDING a copy via `message.forward(INBOX_FORWARD_TO)` is optional. The
  // destination must be VERIFIED first (Dashboard → Destination addresses, or
  // `npx wrangler email routing addresses create you@gmail.com`). Leave
  // INBOX_FORWARD_TO empty to disable forwarding.
  //
  // REPLYING/SENDING (not used by this showcase) WOULD need a binding:
  //   "send_email": [{ "name": "EMAIL" }]
  // plus `npx wrangler email sending enable yourdomain.com`. Add it only if you
  // wire an outbound reply flow.
  "vars": {
    // Set by scripts/set-guardian-project.mjs on every deploy: core-guardian
    // attributes this Worker's spend and routing decisions to this name.
    "GUARDIAN_PROJECT": "core-template-cf-reui",
    "AI_GATEWAY_ID": "default-gateway",
    "MODEL_CHAT": "@cf/openai/gpt-oss-120b",
    "MODEL_EXTRACT": "@cf/openai/gpt-oss-120b",
    "MODEL_DRAFT": "@cf/openai/gpt-oss-120b",
    "MODEL_TRANSCRIBE": "@cf/openai/whisper-large-v3-turbo",
    "DEFAULT_MODEL_EMBEDDING": "@cf/baai/bge-large-en-v1.5",
    // Optional verified destination for message.forward() in the email handler.
    // Empty string = forwarding disabled (the message is stored in D1 only).
    "INBOX_FORWARD_TO": "",
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "f47ec3ba218b4613b96258047f21250a",
      "remote": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "core-template-cf-reui",
      "database_id": "c1452c1a-8dde-4e87-9258-f6a40f315e11",
      "migrations_dir": "drizzle",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GH_TOKEN",
    },
    {
      "binding": "CLOUDFLARE_ACCOUNT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_ACCOUNT_ID",
    },
    {
      "binding": "CLOUDFLARE_WRANGLER_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_WRANGLER_API_TOKEN",
    },
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY",
    },
    {
      "binding": "AI_GATEWAY_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_GATEWAY_TOKEN",
    },
    {
      "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1",
    },
    {
      "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2",
    },
    {
      "binding": "GOOGLE_CREDS_SA_CLIENT_EMAIL",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_CLIENT_EMAIL",
    },
  ],
  //  wrangler vectorize create core-template-cf-reui-career-memory --preset @cf/baai/bge-large-en-v1.5
  "vectorize": [
    {
      "binding": "VECTORIZE_CAREER_MEMORY",
      "index_name": "core-template-cf-reui",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_AUDIO_BUCKET",
      "bucket_name": "core-template-cf-reui-audio",
      "remote": true,
    },
    {
      "bucket_name": "core-template-cf-reui-files",
      "binding": "R2_FILES_BUCKET",
      "remote": true,
    },
  ],
}
